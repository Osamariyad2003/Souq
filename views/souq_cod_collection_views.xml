<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_souq_cod_collection_list" model="ir.ui.view">
        <field name="name">souq.cod.collection.list</field>
        <field name="model">souq.cod.collection</field>
        <field name="arch" type="xml">
            <list string="COD Collections" decoration-danger="variance != 0 and state != 'pending'"
                  decoration-muted="state == 'failed'">
                <field name="name"/>
                <field name="order_id"/>
                <field name="invoice_id"/>
                <field name="branch_id"/>
                <field name="driver_id"/>
                <field name="amount_expected"/>
                <field name="amount_collected"/>
                <field name="variance"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'settled'"
                       decoration-info="state == 'collected'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_souq_cod_collection_form" model="ir.ui.view">
        <field name="name">souq.cod.collection.form</field>
        <field name="model">souq.cod.collection</field>
        <field name="arch" type="xml">
            <form string="COD Collection">
                <header>
                    <button name="%(souq.action_souq_cod_collect_wizard)d" type="action"
                            string="Record Collection" class="btn-primary"
                            invisible="state != 'pending'"
                            context="{'default_collection_id': id}"/>
                    <button name="action_mark_failed" type="object" string="Mark Failed"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,collected,settled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id" readonly="1"/>
                            <field name="invoice_id" readonly="1"/>
                            <field name="branch_id" readonly="1"/>
                            <field name="driver_id" readonly="state != 'pending'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_expected"/>
                            <field name="amount_collected"/>
                            <field name="variance"/>
                            <field name="settlement_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_souq_cod_collection_search" model="ir.ui.view">
        <field name="name">souq.cod.collection.search</field>
        <field name="model">souq.cod.collection</field>
        <field name="arch" type="xml">
            <search string="COD Collections">
                <field name="name"/>
                <field name="order_id"/>
                <field name="driver_id"/>
                <field name="branch_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="collected" string="Collected" domain="[('state', '=', 'collected')]"/>
                <filter name="settled" string="Settled" domain="[('state', '=', 'settled')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="has_variance" string="With Variance" domain="[('variance', '!=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_souq_cod_collection" model="ir.actions.act_window">
        <field name="name">COD Collections</field>
        <field name="res_model">souq.cod.collection</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_souq_cod_collection_my" model="ir.actions.act_window">
        <field name="name">My Deliveries &amp; Collections</field>
        <field name="res_model">souq.cod.collection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('driver_id', '=', uid)]</field>
        <field name="context">{'search_default_pending': 1, 'search_default_collected': 1}</field>
    </record>
</odoo>
