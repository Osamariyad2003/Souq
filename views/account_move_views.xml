<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_souq" model="ir.ui.view">
        <field name="name">account.move.form.souq</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']" position="before">
                <group string="Souq COD" invisible="payment_mode != 'cod'">
                    <field name="payment_mode" invisible="1"/>
                    <field name="branch_id" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="after">
                <page string="E-Invoice (ZATCA QR)" name="souq_einvoice"
                      invisible="move_type not in ('out_invoice', 'out_refund')">
                    <group>
                        <group>
                            <field name="einvoice_reference" readonly="1"/>
                            <field name="seller_tax_id"/>
                            <field name="buyer_tax_id"/>
                            <field name="tax_breakdown" widget="text" readonly="1"/>
                        </group>
                        <group>
                            <field name="qr_image" widget="image" readonly="1"
                                   invisible="not qr_image"/>
                            <field name="qr_payload" readonly="1" invisible="not qr_payload"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
