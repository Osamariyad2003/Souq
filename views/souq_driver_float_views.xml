<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_souq_driver_float_list" model="ir.ui.view">
        <field name="name">souq.driver.float.list</field>
        <field name="model">souq.driver.float</field>
        <field name="arch" type="xml">
            <list string="Driver Cash Floats" editable="bottom">
                <field name="driver_id"/>
                <field name="date"/>
                <field name="opening_balance"/>
                <field name="closing_balance"/>
                <field name="difference"/>
            </list>
        </field>
    </record>

    <record id="view_souq_driver_float_form" model="ir.ui.view">
        <field name="name">souq.driver.float.form</field>
        <field name="model">souq.driver.float</field>
        <field name="arch" type="xml">
            <form string="Driver Cash Float">
                <sheet>
                    <group>
                        <field name="driver_id"/>
                        <field name="date"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="opening_balance"/>
                        <field name="closing_balance"/>
                        <field name="difference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_souq_driver_float" model="ir.actions.act_window">
        <field name="name">Driver Cash Floats</field>
        <field name="res_model">souq.driver.float</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
