<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_souq" model="ir.ui.view">
        <field name="name">res.partner.form.souq</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" icon="fa-money"
                        name="action_view_souq_custody_collections"
                        invisible="not is_souq_driver">
                    <field name="souq_custody_balance" widget="statinfo" string="In Custody"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="is_souq_driver" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
