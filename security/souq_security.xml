<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_souq" model="ir.module.category">
        <field name="name">Souq Connect</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_souq_driver" model="res.groups">
        <field name="name">Souq Driver</field>
        <field name="category_id" ref="module_category_souq"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
        <field name="comment">Delivery drivers: can see and act only on their own deliveries and cash collections.</field>
    </record>

    <record id="group_souq_cashier" model="res.groups">
        <field name="name">Souq Cashier</field>
        <field name="category_id" ref="module_category_souq"/>
        <field name="comment">Branch cashiers: can record cash collections from drivers.</field>
    </record>

    <record id="group_souq_accountant" model="res.groups">
        <field name="name">Souq Accountant</field>
        <field name="category_id" ref="module_category_souq"/>
        <field name="comment">Can confirm driver settlements and post accounting entries.</field>
    </record>

    <record id="group_souq_manager" model="res.groups">
        <field name="name">Souq Manager</field>
        <field name="category_id" ref="module_category_souq"/>
        <field name="implied_ids" eval="[(4, ref('group_souq_accountant')), (4, ref('group_souq_cashier'))]"/>
        <field name="comment">Full access to branches, settlements and Souq Connect configuration.</field>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Record rules: drivers see only their own work. -->
    <record id="rule_souq_cod_collection_driver_own" model="ir.rule">
        <field name="name">Souq COD Collection: driver sees own only</field>
        <field name="model_id" ref="model_souq_cod_collection"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_souq_driver'))]"/>
    </record>

    <record id="rule_souq_driver_settlement_driver_own" model="ir.rule">
        <field name="name">Souq Driver Settlement: driver sees own only</field>
        <field name="model_id" ref="model_souq_driver_settlement"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_souq_driver'))]"/>
    </record>

    <record id="rule_souq_driver_float_driver_own" model="ir.rule">
        <field name="name">Souq Driver Float: driver sees own only</field>
        <field name="model_id" ref="model_souq_driver_float"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_souq_driver'))]"/>
    </record>

    <record id="rule_stock_picking_driver_own" model="ir.rule">
        <field name="name">Souq Delivery: driver sees own deliveries only</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="domain_force">[('driver_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_souq_driver'))]"/>
    </record>

    <record id="rule_souq_cod_collection_manager_all" model="ir.rule">
        <field name="name">Souq COD Collection: manager/accountant/cashier see all</field>
        <field name="model_id" ref="model_souq_cod_collection"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_souq_manager')), (4, ref('group_souq_accountant')), (4, ref('group_souq_cashier'))]"/>
    </record>

    <record id="rule_souq_driver_settlement_manager_all" model="ir.rule">
        <field name="name">Souq Driver Settlement: manager/accountant/cashier see all</field>
        <field name="model_id" ref="model_souq_driver_settlement"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_souq_manager')), (4, ref('group_souq_accountant')), (4, ref('group_souq_cashier'))]"/>
    </record>
</odoo>
