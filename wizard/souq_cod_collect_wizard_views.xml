<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_souq_cod_collect_wizard_form" model="ir.ui.view">
        <field name="name">souq.cod.collect.wizard.form</field>
        <field name="model">souq.cod.collect.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Cash Collection">
                <group>
                    <field name="collection_id" invisible="1"/>
                    <field name="driver_id"/>
                    <field name="amount_expected"/>
                    <field name="amount_collected"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_souq_cod_collect_wizard" model="ir.actions.act_window">
        <field name="name">Record Cash Collection</field>
        <field name="res_model">souq.cod.collect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
